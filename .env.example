# 复制为 .env 后按需填写。不要提交真实 token 或 API key。

# 写操作访问控制。必须设置为不可猜测的随机值；留空时服务保持只读。
ACCESS_TOKEN=replace-with-a-long-random-token

# 文本 AI（OpenAI-compatible）
DEEPSEEK_API_KEY=replace-with-text-api-key
DEEPSEEK_MODEL=replace-with-text-model
DEEPSEEK_BASE_URL=https://api.example.com/v1
DEEPSEEK_MAX_TOKENS=6000
# 可选备用提供商，JSON 数组；每项可包含 apiKey、model、baseUrl、maxTokens。
TEXT_API_PROVIDERS=[]
TEXT_API_TIMEOUT_MS=90000

# 图像 AI（OpenAI-compatible images/generations）
IMAGE_API_KEY=replace-with-image-api-key
IMAGE_MODEL=replace-with-image-model
IMAGE_BASE_URL=https://api.example.com/v1
IMAGE_SIZE=1024x1024
# 可选备用提供商，JSON 数组；每项可包含 apiKey、model、baseUrl、size。
IMAGE_API_PROVIDERS=[]
IMAGE_API_TIMEOUT_MS=120000

# 第三方错题集成（登录凭据由应用写入受忽略的本地文件）
CXYONLY_API_BASE_URL=https://example.com/api
CXYONLY_API_TIMEOUT_MS=20000

# 服务监听。本机使用 127.0.0.1；仅在有额外网络防护时使用 0.0.0.0。
HOST=127.0.0.1
PORT=8765
